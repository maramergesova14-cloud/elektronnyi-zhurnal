# Для PostgreSQL заполни эти переменные. Если POSTGRES_DB не задана,
# проект использует SQLite для локального запуска.
POSTGRES_DB=electronic_journal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-this-in-real-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
